<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<style>
  table { border-collapse: collapse; font-family: 'Segoe UI', Arial, sans-serif; }
  th { background-color: #0b3554; color: #ffffff; font-weight: bold; border: 1px solid #000000; padding: 10px; text-align: center; font-size: 14px; }
  td { border: 1px solid #d3d3d3; padding: 8px 12px; font-size: 13px; text-align: left; }
  .num { text-align: center; font-weight: bold; }
  .login { font-weight: bold; color: #0b3554; background-color: #f0f4f8; }
  .pass { font-weight: bold; color: #d97706; background-color: #fef3c7; }
  .admin-row { background-color: #eef2ff; }
</style>
</head>
<body>
  <h2>EUROASIA EDUCATION CRM — XODIMLAR VA USTOZLAR LOGIN / PAROLLARI</h2>
  <p><b>Sanasi:</b> 2026-yil, Iyul | <b>Holati:</b> Maxfiy hujjat</p>
  <table>
    <thead>
      <tr>
        <th style="width:50px">№</th>
        <th style="width:180px">Xodim F.I.O</th>
        <th style="width:140px">Lavozimi (Roli)</th>
        <th style="width:160px">Login (Username)</th>
        <th style="width:140px">Maxfiy Parol</th>
        <th style="width:160px">Biriktirilgan Guruh</th>
        <th style="width:200px">Eslatma</th>
      </tr>
    </thead>
    <tbody>
      <tr class="admin-row">
        <td class="num">1</td>
        <td><b>Direktor (Admin)</b></td>
        <td>👑 Administrator</td>
        <td class="login">direktor</td>
        <td class="pass">admin2026</td>
        <td>Barcha bo'limlar</td>
        <td>Markaz rahbari asosiy logini</td>
      </tr>
      <tr>
        <td class="num">2</td>
        <td><b>Ustoz Anvar</b></td>
        <td>👨‍🏫 O'qituvchi</td>
        <td class="login">anvar</td>
        <td class="pass">1111</td>
        <td>IELTS Morning</td>
        <td>O'qituvchi shaxsiy kabineti</td>
      </tr>
      <tr>
        <td class="num">3</td>
        <td><b>Ustoz Malika</b></td>
        <td>👩‍🏫 O'qituvchi</td>
        <td class="login">malika</td>
        <td class="pass">2222</td>
        <td>General English</td>
        <td>O'qituvchi shaxsiy kabineti</td>
      </tr>
    </tbody>
  </table>
</body>
</html>
